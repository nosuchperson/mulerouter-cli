# MuleRouter CLI Configuration
# Copy this file to .env and fill in your values.

# Required: API key for authentication
# Get one at https://www.mulerouter.ai/app/api-keys
MULEROUTER_API_KEY=your-api-key-here

# Optional: which site to talk to. Defaults to "mulerouter".
# Valid values: "mulerouter" (api.mulerouter.ai) or "mulerun" (api.mulerun.com)
# MULEROUTER_SITE=mulerouter

# Optional: custom base URL. Takes priority over MULEROUTER_SITE.
# MULEROUTER_BASE_URL=https://api.mulerouter.ai
